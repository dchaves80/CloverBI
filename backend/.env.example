# ============================================
# CloverBI Backend - Environment Variables
# ============================================

# Server port
PORT=3001

# ─── CloverBI DB (SQL Server — siempre) ───
# Base de datos interna de CloverBI (templates, usuarios, etc.)
DB_SERVER=154.12.252.27
DB_PORT=2433
DB_USER=sa
DB_PASSWORD=
DB_NAME=CloverBI

# ─── Client DB (la DB del cliente — cualquier tipo) ───
# DB donde viven los datos reales de los dashboards
# Tipos soportados: mssql | postgresql | mysql | mariadb
CLIENT_DB_TYPE=postgresql
CLIENT_DB_HOST=
CLIENT_DB_PORT=5432
CLIENT_DB_USER=
CLIENT_DB_PASS=
CLIENT_DB_NAME=

# ─── Ivy / Clover Agent ───
# WebSocket URL del agente Ivy
CLOVER_URL=wss://clover.neosolutions.com.ar/ws
# Gateway token (docker exec clover-bi cat /home/node/.openclaw/openclaw.json | grep token)
CLOVER_TOKEN=
